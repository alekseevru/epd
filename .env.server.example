# Скопируйте этот файл как .env рядом с docker-compose.server.yml.
AGR_HTTP_PORT=3000
TMS_LOGIN=your_tms_login
TMS_PASSWORD=your_tms_password

# Не публикуйте этот файл и не добавляйте реальные секреты в Git.
KONTUR_CLIENT_ID=ci_your_client_id
KONTUR_CLIENT_SECRET=your_client_secret
KONTUR_REDIRECT_URI=https://epd.ylrus.com/api/kontur/callback
KONTUR_LOGISTICS_BOX_ID=00000000-0000-0000-0000-000000000000
KONTUR_SCOPES=openid profile email offline_access kl.public.api kl.transportations.orders.public.api Diadoc.PublicAPI

# Глубина загрузки документов для вкладки «Контроль подписания», в месяцах.
KONTUR_CONTROL_MONTHS=4

# Необязательно. Для ЭТрН ссылка строится автоматически по kl-id.
# Может использоваться как резервный шаблон для иных типов документов.
# Доступные подстановки: {boxId}, {messageId}, {entityId}.
KONTUR_DOCUMENT_URL_TEMPLATE=

